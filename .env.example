# Secret key for session cryptographic signing
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Google Gemini API key (optional for basic arithmetic, required for AI Advisor)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Database connection URL (defaults to SQLite instance/finance.db)
DATABASE_URL=sqlite:///instance/finance.db

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# Currency and defaults
CURRENCY_SYMBOL=₹
DEFAULT_SAVINGS_TARGET_PCT=20.0
